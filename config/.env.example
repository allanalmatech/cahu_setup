# CAHU platform configuration.
#
# This is the tracked copy, mirrored from a working .env so the deployment
# values live in the repository. Copy it to .env on the target server and
# fill in the keys marked blank before starting the application.
#
# php/config/.env itself is deliberately not tracked, so a real password or
# key added later cannot be committed by accident.


# ---------------------------------------------------------------------
#  CAHU Platform - environment configuration
#  Copy this file to config/.env and fill in your own values.
#  config/.env must never be committed to version control.
# ---------------------------------------------------------------------

APP_NAME="CAHU Agribusiness Platform"
APP_SHORT_NAME="CAHU"
APP_ENV=production
APP_DEBUG=false
APP_URL="http://localhost:8080"
# Set when the app is served from a sub folder, e.g. "/cahu" - otherwise leave empty.
APP_BASE_PATH=
APP_TIMEZONE="Africa/Kampala"
APP_LOCALE=en_UG
APP_CURRENCY=UGX
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cahu_platform
DB_USERNAME=cahu_user
DB_PASSWORD=

# --- Session / security ---
SESSION_NAME=CAHUSESSID
# Idle timeout in seconds (1800 = 30 minutes)
SESSION_LIFETIME=1800
SESSION_SECURE_COOKIE=false
MAX_LOGIN_ATTEMPTS=5

# --- File uploads ---
# Absolute path on disk and the URL prefix that maps to it.
UPLOAD_PATH=
UPLOAD_URL=/storage/uploads
MAX_IMAGE_KB=4096
MAX_DOC_KB=10240
MAX_VIDEO_KB=102400

# --- SMS notifications ---
SMS_ENABLED=false
SMS_PROVIDER=generic
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=CAHU

# --- Email notifications ---
MAIL_TRANSPORT=smtp
MAIL_SMTP_HOST=mail.shopiespot.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=noreply@shopiespot.com
MAIL_SMTP_PASS=

# Left blank on purpose: a live value for this key is kept in .env, which is not
# tracked. Copy this file to .env and fill it in on the target server.
MAIL_SMTP_ENCRYPTION=ssl
MAIL_SMTP_AUTH=true
MAIL_FROM_EMAIL=noreply@shopiespot.com
MAIL_FROM_NAME=CAHU
MAIL_REPLY_TO=
MAIL_HELO=mail.shopiespot.com

# --- Maps (Leaflet / OpenStreetMap) ---
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
MAP_DEFAULT_LAT=1.3733
MAP_DEFAULT_LNG=32.8883
MAP_DEFAULT_ZOOM=7
