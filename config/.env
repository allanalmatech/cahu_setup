# CAHU platform configuration.
#
# Blank slate: every value below is either a safe default or deliberately empty
# for the installer to fill in. Nothing here is a secret, so this file is safe to
# read before the install runs and safe to commit as an example.
#
# The installer writes the complete config/.env when it finishes, including a
# freshly generated APP_KEY. Do not type a production key here.

APP_NAME="CAHU Agribusiness Platform"
APP_SHORT_NAME="CAHU"
APP_ENV=production
APP_DEBUG=false
APP_URL=
APP_BASE_PATH=
APP_TIMEZONE="Africa/Kampala"
APP_LOCALE=en_UG
APP_CURRENCY=UGX
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_NAME=CAHUSESSID
SESSION_LIFETIME=1800
SESSION_SECURE_COOKIE=

UPLOAD_PATH=
UPLOAD_URL=/storage/uploads

MAIL_TRANSPORT=log
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="CAHU"

SMS_ENABLED=false
