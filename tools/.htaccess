# ---------------------------------------------------------------------
#  Deny direct web access to the development tools.
#
#  These scripts load the application and print its internals: the route
#  table, the controller list, the permission map, the template layout,
#  and - for test-mail.php - the configured SMTP conversation. None of
#  that belongs to a visitor.
#
#  Every script in this directory also refuses to run when PHP_SAPI is not
#  'cli', so the protection does not depend on the server honouring
#  .htaccess. This file is the Apache-side half of that.
# ---------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule . - [F,L]
</IfModule>

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Apache 2.2 fallback
<IfModule mod_access_compat.c>
    Order allow,deny
    Deny from all
</IfModule>
